    keyspot=${SPACK_KEYSPOT}
    keyname=$USER-spack-key-compiled-v$(date +%Y%m%d)
    spack gpg export $keyspot/$keyname.pub.gpg
    for i in $keyspot/*; do spack gpg trust $i; done

── How to create lua modulefile ────────────────────────────────────────────────

  spack -C /apps/helpers/spack/intel/ module lmod refresh 'package_name'
  spack debug report

EOF

}


function spack_update ()
{

  if [ -z "${SPACK_ROOT}" ]; then
    echo -e "please to update first activate spackon, then: spackon -u"
    exit 1
  fi

  local MODE=${1:-stable}
  [[ "$MODE" != "dev" ]] && MODE="stable"

  ENVS=$(spack_envs update)

  TARGET_DIR="${SPACK_INSTALL_DIR}/spack"

  # Backup existing spack directory
  if [ -d "$TARGET_DIR" ]; then
     MONTH=$(date +%b)
     DAY=$(date +%d)
     YEAR=$(date +%Y)
     NEW_DIR_NAME="${SPACK_INSTALL_DIR}/spack.${MONTH,,}${DAY}.${YEAR}"
     echo "Moving existing directory $TARGET_DIR to $NEW_DIR_NAME..."
     mv "$SPACK_ROOT" "$NEW_DIR_NAME"
  fi

  cd "${SPACK_INSTALL_DIR}/"

  if [ "$MODE" = "dev" ]; then
    echo "Cloning latest develop branch..."
    git clone --depth=1 "$SPACK_REPO_URL"
  else
    echo "Fetching latest stable release tag..."
    LATEST_TAG=$(curl -s https://api.github.com/repos/spack/spack/releases/latest \
                 | grep '"tag_name"' | cut -d'"' -f4)
    if [ -z "$LATEST_TAG" ]; then
      echo "Warning: could not fetch latest tag, falling back to develop"
      git clone --depth=1 "$SPACK_REPO_URL"
    else
      echo "Cloning $LATEST_TAG..."
      git clone --depth=1 -c advice.detachedHead=false --branch "$LATEST_TAG" "$SPACK_REPO_URL"
    fi
  fi

  echo "$ENVS"

  # Restore arch config — scopes now live in $ARCH_SCOPE (shared, not in $SPACK_ROOT)
  if [ -d "$SPACK_SCOPE" ]; then
    echo "Using shared intel config from $SPACK_SCOPE"
  elif compgen -G "$NEW_DIR_NAME/intel*" > /dev/null 2>&1; then
    echo "Restoring intel config from backup to $ARCH_SCOPE ..."
    mkdir -p "$ARCH_SCOPE"
    cp -rpa "$NEW_DIR_NAME"/intel* "$ARCH_SCOPE"/
    cp -rpa "$NEW_DIR_NAME"/amd* "$ARCH_SCOPE"/ 2>/dev/null || true
  else
    echo "Warning: intel config not found — recreating $SPACK_SCOPE/config.yaml"
    mkdir -p "$SPACK_SCOPE"
    cat > "$SPACK_SCOPE/config.yaml" << RFEOF
config:
  sbang_path: \${SPACK_ROOT}/bin
  install_tree:
    # admin shared install tree — use: spack -C ${SPACK_SCOPE}
    # spack -C ${SPACK_SCOPE} config get config
    root: ${SPACK_INSTALL_TREE}
    projections:
      all: "{compiler.name}/{compiler.version}/{name}/{version}-{hash:7}"
  locks: true
  db_lock_timeout: 120
  package_lock_timeout: null
  allow_sgid: true
  build_jobs: 8
  shared_linking:
    type: rpath
RFEOF
    cat > "$SPACK_SCOPE/mirrors.yaml" << RFEOF
mirrors:
  spack-public:
    url: ${SPACK_MIRROR_PUBLIC}
    signed: true
  arch:
    url: ${SPACK_MIRROR_ARCH}
    signed: true
RFEOF
    echo "  Created: $SPACK_SCOPE/config.yaml"
    echo "  Created: $SPACK_SCOPE/mirrors.yaml"
  fi

  Spack_Up

  echo "ln -s $ENVS $SPACK_ROOT/var/spack/environments"
  ln -s "$ENVS" "$SPACK_ROOT/var/spack/environments"

  Activate_Spack
}

function Close_Subshell ()
{
   cd
   echo -e "Closing subshell..."

   kill -1 ${SSID} >> /dev/null 2>&1
}

function Spack_setup ()
{
  if [ -z "${SPACK_ROOT}" ]; then
     echo -e "\nIf spack is installed for this user: \n\nUse: spackon --activate to activate "
     exit 1
  fi

  SPACK_LINUX=${HOME}/.spack/linux

  if [ ! -d "${SPACK_LINUX}" ]; then
    mkdir -p ${SPACK_LINUX}
    mkdir -p /apps/helpers/spack/intel/

cat > /apps/helpers/spack/intel/config.yaml << \EOF
config:
  sbang_path: ${SPACK_ROOT}/bin
  install_tree:
    # if you are in admin group, and want to install packages on ARCH system
    # spack -C ${SPACK_ROOT}/arch config get config
    root: ${SPACK_INSTALL_TREE}
EOF

cat > ${SPACK_LINUX}/config.yaml << \EOF
#
# https://spack.readthedocs.io/en/latest/config_yaml.html
#
config:
  module set:
    tcl:  ~/modulefiles/tcl
    lmod: ~/modulefiles/lmod
  install_tree:
    root: $spack/opt/spack
    projections:
# old syntax   all: "${COMPILERNAME}/${COMPILERVER}/${PACKAGE}/${VERSION}-${HASH}"
      all: "{compiler.name}/{compiler.version}/{name}/{version}-{hash}"
  template_dirs:
  - $spack/share/spack/templates
  license_dir: $spack/etc/spack/licenses
  build_stage:
  - $tempdir/$user/spack-stage
  - $user_cache_path/stage
  test_stage: $user_cache_path/test
  source_cache: $spack/var/spack/cache
  misc_cache: $user_cache_path/cache
  connect_timeout: 10
  verify_ssl: true
  suppress_gpg_warnings: false
  install_missing_compilers: false
  checksum: true
  deprecated: false
  dirty: false
  build_language: C
  locks: true
  url_fetch_method: urllib
  ccache: false
  concretizer: clingo
  db_lock_timeout: 3
  package_lock_timeout: null
  shared_linking: rpath
  allow_sgid: true
  # terminal_title: false
  install_status: true
EOF

cat > ${SPACK_LINUX}/modules.yaml << EOF
#
# https://spack.readthedocs.io/en/latest/module_file_support.html
#
# These are configurations for the module set named "default"
#
modules:
  default:
    # Where to install modules
    roots:
     lmod: ~/modulefiles/lmod
    # What type of modules to use
    enable:
      - lmod
    lmod:
      core_compilers:
        - 'gcc@10.3.0'
        - 'gcc@9.3.0'
      hash_length: 7
      hierarchy:
        - mpi
      whitelist:
       - gcc
      blacklist:
       - '%gcc@8.3.1'
      projections:
        all:  '{compiler.name}/{compiler.version}/{name}/{version}'
        ^mpi: '{compiler.name}/{compiler.version}/{name}/{version}/{^mpi.name}/{^mpi.version}'
      all:
        autoload: none
EOF

cat > ${SPACK_LINUX}/concretizer.yaml << EOF
#
# https://spack.readthedocs.io/en/latest/build_settings.html#concretizer-options
#
concretizer:
  # Whether to consider installed packages or packages from buildcaches when
  # concretizing specs. If `true`, we'll try to use as many installs/binaries
  # as possible, rather than building. If `false`, we'll always give you a fresh
  # concretization.
  reuse: true
  # Options that tune which targets are considered for concretization. The
  # concretization process is very sensitive to the number targets, and the time
  # needed to reach a solution increases noticeably with the number of targets
  # considered.
  targets:
    # Determine whether we want to target specific or generic microarchitectures.
    # An example of the first kind might be for instance "skylake" or "bulldozer",
    # while generic microarchitectures are for instance "aarch64" or "x86_64_v4".
    granularity: microarchitectures
    # If "false" allow targets that are incompatible with the current host (for
    # instance concretize with target "icelake" while running on "haswell").
    # If "true" only allow targets that are compatible with the host.
    host_compatible: true
  # When "true" concretize root specs of environments together, so that each unique
  # package in an environment corresponds to one concrete spec. This ensures
  # environments can always be activated. When "false" perform concretization separately
  # on each root spec, allowing different versions and variants of the same package in
  # an environment.
  unify: when_possible
EOF

  fi

# https://spack.readthedocs.io/en/latest/build_settings.html#external-packages

  echo -e "\nAdding external compilers... \n"
  spack compiler find
  ml intel/2022.2
  spack compiler find
}

function Spack_Add_Packages ()
{

  if [ -z "${SPACK_ROOT}" ]; then
     echo -e "\nIf spack is installed for this user: \n\nUse: spackon --activate to activate "
     exit 1
  fi

  prefix='-f'
  args=${@#"$prefix"}

  Spack_setup

  if [ -z "${args}" ]; then
     export BASE_COMPILERS=/apps/linux-centos8-intel
  else
     export BASE_COMPILERS=${args}
  fi

  echo $BASE_COMPILERS
  SPACK_LINUX=${HOME}/.spack/linux

cat > ${SPACK_LINUX}/packages.yaml << EOF
packages:
EOF

  mapfile -t COMPILERS < <(ls -d ${BASE_COMPILERS}/*/ 2>/dev/null | xargs -n1 basename)

  if (( ${#COMPILERS[@]} == 0 )); then
    echo "No compilers found under $BASE_COMPILERS" >&2
    exit 1
  else
    echo -e "\nSearching for installed packages on: $BASE_COMPILERS"
    echo -e "\nThis task might take a while. It is needed run once...\n"

  COUNT=0

  for compiler in "${COMPILERS[@]}"; do
    for package in $(ls -d ${BASE_COMPILERS}/${compiler}/*/ 2>/dev/null | xargs -n1 basename); do

      # Support both spec.json (spack >= 0.17) and legacy spec.yaml
      SPEC_FILE=""
      [[ -f "${BASE_COMPILERS}/${compiler}/${package}/.spack/spec.json" ]] && \
          SPEC_FILE="${BASE_COMPILERS}/${compiler}/${package}/.spack/spec.json"
      [[ -z "$SPEC_FILE" && -f "${BASE_COMPILERS}/${compiler}/${package}/.spack/spec.yaml" ]] && \
          SPEC_FILE="${BASE_COMPILERS}/${compiler}/${package}/.spack/spec.yaml"
      [[ -z "$SPEC_FILE" ]] && continue

      if [[ "$SPEC_FILE" == *.json ]]; then
          package_name=$(python3 -c "import json,sys; s=json.load(open('$SPEC_FILE')); print(list(s['spec']['nodes'])[0]['name'])" 2>/dev/null)
      else
          spec_name=$(sed '2!d' "$SPEC_FILE" 2>/dev/null)
          package_name=$(echo ${spec_name} | sed 's/..//;s/.$//')
      fi
      [[ -z "$package_name" ]] && continue

      package_ver=$(echo $package | awk -F- '{print $(NF-1)}')
      CC=$(echo ${compiler} | cut -f 1 -d -)
      VER=$(echo ${compiler} | cut -f 2 -d -)

     (( COUNT++ ))

cat >> ${SPACK_LINUX}/packages.yaml << EOF
  ${package_name}:
    buildable: false
    externals:
    - spec: $package_name@$package_ver %${CC}@${VER}
      prefix: $BASE_COMPILERS/$compiler/$package
EOF
        done
      done
  fi

  echo "${COUNT} packages were added."

  echo -e "\nSearching for additional external software on ARCH..."
  spack external find --all --not-buildable

  sleep 3

  if [[ -n ${SPACK_ENV} ]]; then
     ENV_SPACK=$(echo $SPACK_ENV | rev | cut -d'/' -f 1 | rev)
     echo $ENV_SPACK
     spackon -m ${SPACK_LINUX}/packages.yaml ${SPACK_ROOT}/var/spack/environments/${ENV_SPACK}/spack.yaml
  else
     if [[ -f $SPACK_ROOT/etc/spack/packages.yaml ]]; then
        spackon -m ${SPACK_LINUX}/packages.yaml ${HOME}/.spack/packages.yaml $SPACK_ROOT/etc/spack/packages.yaml
     else
        spackon -m ${SPACK_LINUX}/packages.yaml ${HOME}/.spack/packages.yaml
     fi
  fi

