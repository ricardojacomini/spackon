function Install_Packages ()
{

  prefix='-i'
  env=${@#"$prefix"}

  # echo "env: ${env} @:  ${@}"

  if [[ ( $@ == *'--'* ) || ( "${env}" == '-' ) || ( "${env}" == 'locally -' ) ]]; then
    clear
    usage
    exit 0
  elif [[ ( $@ == "-i" ) ]]; then
    sbatch -c 8 -t 240 --wrap="spack env activate locally; time spack install -j 8"
  elif [[ ( $@ == "-i -push" ) ]]; then
    if [[ "${USER}" != "${SPACK_ADMIN_USER}" ]]; then
      echo "Error!! '-i -push' is restricted to ${SPACK_ADMIN_USER}."; exit 1
    fi
    if ! spack gpg list 2>/dev/null | grep -q 'sec\|pub'; then
      echo "Error!! No GPG key found. Run: spackon --keys create"; exit 1
    fi
    sbatch -c 8 -t 240 --wrap="spack env activate locally; time spack install -j 8 && spack buildcache push arch \$(spack find --no-groups --format '/{hash}')"
  elif [[ ( $@ == "-i -arch" ) ]]; then
    sbatch -c 8 -t 240 --wrap="spack env activate locally; time spack -C ${SPACK_SCOPE} install -j 8"
  elif [[ ( $@ == "-i -arch-push" ) ]]; then
    if [[ "${USER}" != "${SPACK_ADMIN_USER}" ]]; then
      echo "Error!! '-i -arch-push' is restricted to ${SPACK_ADMIN_USER}."; exit 1
    fi
    if ! spack gpg list 2>/dev/null | grep -q 'sec\|pub'; then
      echo "Error!! No GPG key found. Run: spackon --keys create"; exit 1
    fi
    sbatch -c 8 -t 240 --wrap="spack env activate locally; time spack -C ${SPACK_SCOPE} install -j 8 && spack -C ${SPACK_SCOPE} buildcache push arch \$(spack find --no-groups --format '/{hash}')"
  elif [[ ( $@ == *'-arch'* ) && ( "${env}" != *'locally'* ) ]]; then
    sbatch -c 8 -t 240 --wrap="spack env activate ${2}; time spack -C ${SPACK_SCOPE} install -j 8"
  elif [[ ( $@ == *'-i locally -arch' ) ]]; then
    sbatch -c 8 -t 240 --wrap="spack env activate locally; time spack -C ${SPACK_SCOPE} install -j 8"
  elif [[ ( $@ == *'-i locally'* ) && ( "${env}" != *'rf'* ) ]]; then
    sbatch -c 8 -t 240 --wrap="spack env activate locally; time spack install -j 8"
  fi

  exit 0
}

function Install_Spack ()
{
  export SPACK_ROOT=${SPACK_INSTALL_DIR}

  if [ ! -d "${SPACK_ROOT}" ]
  then
     echo -e "\nInstalling Spack"
     echo -e "\nFor more details, see: https://spack.readthedocs.io/en/latest/"

     mkdir -p "${HOME}/modulefiles"
     mkdir -p "${SPACK_ROOT}"
     cd "${SPACK_ROOT}"
     git clone --depth=1 ${SPACK_REPO_URL}

     [ -f /apps/Lmod ] && source /apps/Lmod
     command -v ml &>/dev/null && ml restore

     export MODULEPATH=${MODULEPATH}:${HOME}/modulefiles/lmod
     export LMOD_IGNORE_CACHE=1

     source "${SPACK_ROOT}/spack/share/spack/setup-env.sh"

     # Copy shared mirrors config from ARCH_SCOPE — single source of truth
     # To change mirror paths, edit: ${SPACK_SCOPE}/mirrors.yaml
     # Ensure shared scope config exists before any spack -C calls
     Spack_setup

     if [ -f "${SPACK_SCOPE}/mirrors.yaml" ]; then
       mkdir -p "${HOME}/.spack"
       cp "${SPACK_SCOPE}/mirrors.yaml" "${HOME}/.spack/mirrors.yaml"
       echo "Mirrors loaded from ${SPACK_SCOPE}/mirrors.yaml"
     else
       echo "Warning: ${SPACK_SCOPE}/mirrors.yaml not found — no mirrors configured"
     fi

     if [ -d "${SPACK_SCOPE}" ]; then
       spack -C "${SPACK_SCOPE}" buildcache keys --install --trust 2>/dev/null || true
     fi

     #spack gpg init
     #spack gpg create ${USER}
     spack env create locally
     spack env activate locally
     spack concretize -f
     spack install

     spack env deactivate

     Activate_Spack

  else
     echo -e "\nSpack is installed for this user: \n\nUse: spackon --activate to activate, or --r to remove it ${SPACK_ROOT}. "
  fi
}

function spack_envs ()
{

    prefix='-e'
    ENVS=${@#"$prefix"}

    # Check if the resulting value is 'update'
    if [ "$ENVS" = "update" ]; then
       ENVS=/data/$(id -gn)/spack_enviroments/$(id -un)
       if [ -L "$SPACK_ROOT/var/spack/environments" ]; then
         echo "$ENVS"
	 return 0
       fi  
    else
       if [ -z "${ENVS}" ]; then
          echo -e "\nNo path to new enviroment"
          echo -e "\nUsage: ${PROGNAME} -e /data/$(id -gn)/spack_enviroments/$(id -un)"
          exit 1
       else
          echo -e "\nYour spack environment has already been transferred to: \n"
          readlink "$SPACK_ROOT/var/spack/environments"
          echo -e "\nNo action needed. \n"
	  exit 1
       fi
    fi
   
    if [ ! -z "${SPACK_ROOT}" ]; then
 
     echo -e "\nMove spack environments" 
     spack env list
     echo -e "\nAre you sure you want to move those envs to $ENVS?\n"

     while true; do
       read -p "Move environments to $ENVS? (yes/no) " yn
       case "${yn,,}" in
         yes|y) break ;;
         no|n)  exit 0 ;;
         *)     echo "Please answer yes or no." ;;
       esac
     done
         mkdir -p "$ENVS"
         rsync -rav "$SPACK_ROOT/var/spack/environments/" "$ENVS"
