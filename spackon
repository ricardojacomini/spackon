function stage0_setup ()
{
  # Must be SPACK_ADMIN_USER
  if [[ "${USER}" != "${SPACK_ADMIN_USER}" ]]; then
    echo "Error!! 'stage0-setup' is restricted to ${SPACK_ADMIN_USER}."
    echo "        You are: ${USER}"
    exit 1
  fi

  # Must have sudo
  if ! sudo -n true 2>/dev/null; then
    echo "Error!! 'stage0-setup' requires sudo privileges."
    echo "        Run: sudo -v   to authenticate first, then retry."
    exit 1
  fi

  echo "==> Stage 0: creating shared directories for spackon"
  echo ""

  # Affiliation root dirs under /scratch — group-writable so users can mkdir their own subtrees
  local aff_dirs=("/scratch/jhu" "/scratch/schmidt")
  for aff in "${aff_dirs[@]}"; do
    if [ -d "$aff" ]; then
      echo "  [exists]  $aff"
    else
      sudo mkdir -p "$aff"
      echo "  [created] $aff"
    fi
    sudo chown "root:${SPACK_DEPLOY_GROUP}" "$aff"
    sudo chmod 775 "$aff"
    echo "            chown root:${SPACK_DEPLOY_GROUP}  chmod 775"
  done
  echo ""

  local dirs=(
    "${SPACK_SCRATCH}"
    "${SPACK_INSTALL_TREE}"
    "${SPACK_INSTALL_TREE_AMD}"
    "${SPACK_KEYSPOT}"
  )

  for dir in "${dirs[@]}"; do
    if [ -d "$dir" ]; then
      echo "  [exists]  $dir"
    else
      sudo mkdir -p "$dir"
      echo "  [created] $dir"
    fi
    sudo chown "${SPACK_ADMIN_USER}:${SPACK_DEPLOY_GROUP}" "$dir"
    sudo chmod 2775 "$dir"
    echo "            chown ${SPACK_ADMIN_USER}:${SPACK_DEPLOY_GROUP}  chmod 2775"
  done

  echo ""
  echo "==> Done. Verify with:"
  echo "    stat ${SPACK_SCRATCH} | grep Access"
  echo "    stat ${SPACK_INSTALL_TREE} | grep Access"
  echo ""
  echo "==> Next: each admin runs once:"
  echo "    spackon --keys create"
  echo "    spackon --keys export"
  echo "    # then master runs: spackon --keys trust"
}

function spack_keys ()
{
  if [ -z "${SPACK_ROOT}" ]; then
    echo -e "\nSpack not active. Run: spackon --activate first."
    exit 1
  fi

  local KEYSPOT=${SPACK_KEYSPOT}
  local ACTION="${2:-list}"   # default: list

  # Only admin members may create or export signing keys
  _require_admin() {
    if ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$SPACK_DEPLOY_GROUP"; then
      echo "Error!! '--keys ${1}' requires $SPACK_DEPLOY_GROUP group membership."
      echo "        Contact $SPACK_ADMIN_USER to get added to $SPACK_DEPLOY_GROUP."
      return 1
    fi
  }

  case "$ACTION" in

    create)
      _require_admin create || return 1
      echo -e "\n==> GPG key creation (do this ONCE only — spack has issues with duplicate keys)"
      echo -e "    See: https://github.com/spack/spack/issues/14720\n"
      spack gpg init
      local DEFAULT_NAME="${USER}-admin"
      local DEFAULT_EMAIL="${USER}@jhu.edu"
      read -p "Full name  [${DEFAULT_NAME}]: " GPG_NAME
      read -p "Email      [${DEFAULT_EMAIL}]: " GPG_EMAIL
      GPG_NAME="${GPG_NAME:-$DEFAULT_NAME}"
      GPG_EMAIL="${GPG_EMAIL:-$DEFAULT_EMAIL}"
      spack gpg create "$GPG_NAME" "$GPG_EMAIL"
      echo -e "\nKey created. Run: spackon --keys export   to publish it to $KEYSPOT"
      ;;

    export)
      _require_admin export || return 1
      local KEYNAME="${USER}-spack-key-compiled-v$(date +%Y%m%d)"
      mkdir -p "$KEYSPOT"
      if [ ! -f "$KEYSPOT/${KEYNAME}.pub.gpg" ]; then
        spack gpg export "$KEYSPOT/${KEYNAME}.pub.gpg"
        echo "Public key exported  : $KEYSPOT/${KEYNAME}.pub.gpg"
      else
        echo "Already exists (pick another name or delete first): $KEYSPOT/${KEYNAME}.pub.gpg"
      fi
      if [ ! -f "${HOME}/${KEYNAME}.priv.gpg" ]; then
        spack gpg export --secret "${HOME}/${KEYNAME}.priv.gpg"
        echo "Private key exported : ~/${KEYNAME}.priv.gpg  (keep safe!)"
      else
        echo "Private key already exists: ~/${KEYNAME}.priv.gpg"
      fi
      echo -e "\nOther admins can now trust your key with: spackon --keys trust"
      ;;

    trust)
      if [ ! -d "$KEYSPOT" ]; then
        echo "Key directory not found: $KEYSPOT"
        exit 1
      fi
      echo -e "\n==> Trusting all keys in $KEYSPOT"
      local COUNT=0
      for keyfile in "$KEYSPOT"/*; do
        [ -f "$keyfile" ] || continue
        spack gpg trust "$keyfile" && echo "  trusted: $keyfile"
        (( COUNT++ ))
      done
      echo -e "\n  $COUNT key(s) trusted."
      ;;

    list)
      echo -e "\n==> GPG keys known to spack"
      spack gpg list
      echo -e "\n==> Keys in shared keyspot ($KEYSPOT)"
      ls -1 "$KEYSPOT" 2>/dev/null || echo "  (empty or not found)"
      ;;

    *)
      echo "Error: unknown keys action '$ACTION'"
      echo "Usage: $PROGNAME --keys [create|export|trust|list]"
      exit 1
      ;;
  esac
}

