# `spackon` is a bash wrapper around [Spack](https://spack.readthedocs.io) that 
# manages software installation, shared build caches, and 
# GPG-signed deployments to the ARCH shared software stack. 
# It automatically detects the CPU architecture (Intel or AMD) at runtime and selects 
# the matching config scope and install tree.

PROGNAME=$(basename "$0")
list_all_users="yes"
user="$(/usr/bin/whoami)"

# Single hardcoded value — path to shared config (needed to bootstrap)
ARCH_SCOPE=/apps/helpers/spack

# Load all config from central init file — create with defaults if missing
if [ ! -f "${ARCH_SCOPE}/init" ]; then
  echo "==> ${ARCH_SCOPE}/init not found — creating with defaults..." >&2
  mkdir -p "${ARCH_SCOPE}"
  cat > "${ARCH_SCOPE}/init" << INITEOF
# spackon shared config — ${ARCH_SCOPE}/init
# Central configuration for all spackon settings.
# Edit this file to change any path, group, or URL.

SPACK_DEPLOY_GROUP=spack           # or admin make sure that group was created
SPACK_ADMIN_USER=master
SPACK_INSTALL_TREE=/apps/software/spack/intel
SPACK_INSTALL_TREE_AMD=/apps/software/spack/amd
# SPACK_INSTALL_DIR is auto-detected at runtime: /scratch/{affiliation}/{secondary_group}/spack/{user}
# fallback only if no secondary group found:
# SPACK_INSTALL_DIR=${HOME}/software_spack. see line 65
# SPACK_SCRATCH is auto-detected at runtime: /scratch/{affiliation}/admin/spack
SPACK_SCRATCH=/scratch/admin/spack
SPACK_KEYSPOT=/apps/software/spack/build/keys
SPACK_REPO_URL=https://github.com/spack/spack.git
SPACK_MIRROR_PUBLIC=https://mirror.spack.io
SPACK_MIRROR_ARCH=file:///apps/software/spack/mirror-spack/build_cache
# cache 
INITEOF
  echo "==> Created: ${ARCH_SCOPE}/init  (edit to customize)" >&2
fi
source "${ARCH_SCOPE}/init"

# Auto-detect personal spack install dir under /scratch/{affiliation}/{secondary_group}/spack/{user}
# Affiliation: usernames starting with "ssci" → schmidt, otherwise → jhu
# Secondary group: first group from id -Gn that is not "users" and not the username itself
_spack_affiliation() {
  if [[ "${USER}" == ssci* ]]; then echo "schmidt"; else echo "jhu"; fi
}

# Personal spack install dir — isolated per user, non-admin workflow (spackon -c)
# e.g. rdesouz4  → /scratch/jhu/rdesouz4/spack
# e.g. ssci-user → /scratch/schmidt/ssci-user/spack
SPACK_INSTALL_DIR="/scratch/$(_spack_affiliation)/${USER}/spack"

# Shared admin build area — all $SPACK_DEPLOY_GROUP members build here (Stage 1–3)
# e.g. rdesouz4 → /scratch/jhu/admin/spack
SPACK_SCRATCH="/scratch/$(_spack_affiliation)/admin/spack"

# Auto-detect CPU architecture scope (mirrors modulefile Lua detection)
_cpu_vendor=$(lscpu 2>/dev/null | awk '/Vendor ID/ {print $3}')
if [[ "$_cpu_vendor" == *"AMD"* ]]; then
    SPACK_SCOPE=${ARCH_SCOPE}/amd
    SPACK_INSTALL_TREE=${SPACK_INSTALL_TREE_AMD}
else
    SPACK_SCOPE=${ARCH_SCOPE}/intel
fi
unset _cpu_vendor

spack_stage_and_cd ()
{
    if spack list $1 &> /dev/null; then
        spack stage $1;
        spack cd $1;
        echo -e "run: \nspack -C ${SPACK_SCOPE} build-env $1 ./configure";
    else
        echo "Package not found in Spack.";
    fi
}

help-all ()
{
    spackon --help-all
}

