function spack_cache_push ()
{
  # admin + GPG key required. Explicit spec or --env only. intel scope enforced.
  if ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$SPACK_DEPLOY_GROUP"; then
    echo "Error!! --cache-push requires $SPACK_DEPLOY_GROUP group membership."; exit 1
  fi
  if ! spack gpg list 2>/dev/null | grep -q 'sec\|pub'; then
    echo "Error!! No GPG key found. Run: spackon --keys create"; exit 1
  fi

  local ARG="${2:-}"
  if [ -z "$ARG" ]; then
    echo "Error!! Specify a package or use --env:"
    echo "  spackon --cache-push python@3.11.9"
    echo "  spackon --cache-push --env locally"
    exit 1
  fi

  if [ "$ARG" = "--env" ]; then
    local ENV="${3:-locally}"
    echo "==> Resolving hashes for all packages in env: $ENV"
    HASHES=$(spack -C ${SPACK_SCOPE} env activate "$ENV" 2>/dev/null && \
             spack -C ${SPACK_SCOPE} find --no-groups --format '/{hash}' 2>/dev/null)
  else
    echo "==> Resolving hash for: $ARG (must be installed under intel scope)"
    HASHES=$(spack -C ${SPACK_SCOPE} find --no-groups --format '/{hash}' "$ARG" 2>/dev/null)
  fi

  if [ -z "$HASHES" ]; then
    echo "Error!! Package not found under intel scope. Build with 'spackon -i -arch' first."; exit 1
  fi

  echo ""
  echo "==> Dry-run: packages to push to ARCH cache:"
  spack -C ${SPACK_SCOPE} buildcache list --allarch $ARG 2>/dev/null || \
    spack -C ${SPACK_SCOPE} find -lv $ARG 2>/dev/null
  echo ""
  read -p "Push to arch buildcache? (yes/no): " yn
  case "${yn,,}" in
    yes|y)
      spack -C ${SPACK_SCOPE} buildcache push arch $HASHES
      echo "==> Done. Other admin users can now deploy with: spackon --deploy $ARG"
      ;;
    *) echo "Aborted."; exit 0 ;;
  esac
}

function spack_deploy ()
{
  # admin + trusted GPG key required. Installs from signed cache only → install_tree.
  if ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$SPACK_DEPLOY_GROUP"; then
    echo "Error!! --deploy requires $SPACK_DEPLOY_GROUP group membership."; exit 1
  fi
  if ! spack gpg list 2>/dev/null | grep -q 'pub'; then
    echo "Error!! No trusted keys found. Run: spackon --keys trust"; exit 1
  fi

  local ARG="${2:-}"
  if [ -z "$ARG" ]; then
    echo "Error!! Specify a package or use --env:"
    echo "  spackon --deploy python@3.11.9"
    echo "  spackon --deploy --env locally"
    exit 1
  fi

  if [ "$ARG" = "--env" ]; then
    local ENV="${3:-locally}"
    echo "==> Deploying all packages in env '$ENV' from ARCH cache → install_tree"
    sbatch -c 8 -t 120 --wrap="spack env activate ${ENV}; \
      spack -C ${SPACK_SCOPE} install --use-buildcache only -j 8"
  else
    echo "==> Deploying $ARG from ARCH cache → ${SPACK_INSTALL_TREE}"
    echo "    (will fail if package is unsigned or key not trusted)"
    sbatch -c 8 -t 120 --wrap="spack -C ${SPACK_SCOPE} install --use-buildcache only $ARG"
  fi
}

