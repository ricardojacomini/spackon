    sudo chmod 2775 ${SPACK_KEYSPOT}
    # 2775 = setgid + rwxrwxr-x
    # setgid → new files inherit ${SPACK_DEPLOY_GROUP} group automatically

── Spack config (intel/config.yaml key settings) ─────────────────────────

  locks: true               # prevent DB corruption during concurrent installs
  db_lock_timeout: 120      # wait up to 120s for lock (not fail immediately)
  build_jobs: 8             # shared node — leave room for others
  install_tree.projections: # consistent paths across all admin users
    all: "{compiler.name}/{compiler.version}/{name}/{version}-{hash:7}"

